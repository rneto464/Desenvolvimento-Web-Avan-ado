{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/**"]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/index.js" }
  ],
  "crons": [
    {
      "path": "/api/cron/sync-news",
      "schedule": "0 0 * * *"
    }
  ]
}
